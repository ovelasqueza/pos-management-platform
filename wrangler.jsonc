{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pos-management-platform",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "pos-management-platform"
    }
  ],
  "observability": {
    "enabled": true
  }
  // Variables NO secretas: NEXT_PUBLIC_SUPABASE_URL y NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY van en .env.production
  // (se incrustan al compilar). SUPABASE_SECRET_KEY va como secreto: ver docs/despliegue.md.
}
