{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pos-management-platform",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "pos-management-platform"
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://gbeoczslzjwgnambaoim.supabase.co",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_SF9Y2SVYT3d5DmFHprGRSw_W7BZ1ysZ"
  }
  // SUPABASE_SECRET_KEY NUNCA va aquí porque este archivo va a git.
  // Se configura en el panel de Cloudflare como Secret (cifrado).
}
