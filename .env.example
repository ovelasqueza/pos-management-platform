# Copiar a .env.local y completar. Nunca subir .env.local a git.

# URL del proyecto Supabase (local: http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=

# Clave publicable (sb_publishable_...). Segura para el navegador.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clave secreta (sb_secret_...). SOLO servidor: crear usuarios y restablecer contraseñas.
SUPABASE_SECRET_KEY=
